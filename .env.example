# App Configuration
APP_NAME=HH_Goa_Voice_RAG
ENVIRONMENT=development
LOG_LEVEL=INFO

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=msmarco_xi_indic

# Embedding Model (Indic Multilingual)
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
VECTOR_DIMENSION=384
DISTANCE_METRIC=Cosine

# Groq LLM Inference
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Voice APIs (Strictly Sarvam AI & ElevenLabs)
SARVAM_API_KEY=
ELEVENLABS_API_KEY=

# AWS Deployment Infrastructure (CloudShell & ALB Settings)
AWS_REGION=ap-south-1
AWS_EC2_INSTANCE_TYPE=t3.micro
AWS_NUM_INSTANCES=3
AWS_BACKEND_PORT=8000
AWS_HEALTH_CHECK_PATH=/health
AWS_ALB_NAME=hh-goa-task2-alb
AWS_TARGET_GROUP_NAME=hh-goa-task2-tg

